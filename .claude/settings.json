{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-commit-bump.sh\"",
            "timeout": 15,
            "statusMessage": "Checking release bump keyword..."
          }
        ]
      }
    ]
  }
}
